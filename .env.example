# ─────────────────────────────────────────────────────────────
# 4SF Mini-Game Sidecar — environment variables
# Copy these into Vercel (Project → Settings → Environment Variables).
# ─────────────────────────────────────────────────────────────

# The Base44 app id of the Foursome Finder app (the SHARED backend).
# Find it in the Foursome Finder dashboard → API page.
VITE_BASE44_APP_ID=your-app-id-here

# Comma-separated list of parent origins allowed to pass a member auth token
# into the embedded game iframe (the Foursome Finder app origins). Include the
# base44.app domain AND any custom domain you connect to the main app.
VITE_ALLOWED_PARENT_ORIGINS=https://steadfast-fairway-foursome-find.base44.app
